
package com.example.arabicfloatingboard

import android.app.Activity
import android.content.ClipData
import android.content.ClipboardManager
import android.content.Context
import android.graphics.Canvas
import android.graphics.Color
import android.graphics.Paint
import android.graphics.Path
import android.graphics.PixelFormat
import android.graphics.drawable.GradientDrawable
import android.os.Bundle
import android.content.Intent
import android.net.Uri
import android.provider.Settings
import android.view.Gravity
import android.view.MotionEvent
import android.view.View
import android.view.WindowManager
import android.widget.Button
import android.widget.EditText
import android.widget.LinearLayout
import android.widget.TextView
import android.widget.Toast

class MainActivity : Activity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        val layout = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            gravity = Gravity.CENTER
            setPadding(24, 24, 24, 24)
        }

        layout.addView(TextView(this).apply {
            text = "السبورة العربية العائمة"
            textSize = 24f
            gravity = Gravity.CENTER
        })

        layout.addView(Button(this).apply {
            text = "السماح بالظهور فوق التطبيقات"
            setOnClickListener {
                startActivity(
                    Intent(
                        Settings.ACTION_MANAGE_OVERLAY_PERMISSION,
                        Uri.parse("package:$packageName")
                    )
                )
            }
        })

        layout.addView(Button(this).apply {
            text = "تشغيل السبورة"
            setOnClickListener {
                if (Settings.canDrawOverlays(this@MainActivity)) {
                    startService(
                        Intent(
                            this@MainActivity,
                            FloatingBoardService::class.java
                        )
                    )
                    finish()
                } else {
                    Toast.makeText(
                        this@MainActivity,
                        "امنح الإذن أولاً",
                        Toast.LENGTH_SHORT
                    ).show()
                }
            }
        })

        setContentView(layout)
    }
}

class FloatingBoardService : android.app.Service() {
    private lateinit var wm: WindowManager
    private var floatingView: View? = null

    override fun onBind(intent: Intent?) =
        null

    override fun onStartCommand(
        intent: Intent?,
        flags: Int,
        startId: Int
    ): Int {
        if (floatingView == null) showBoard()
        return START_NOT_STICKY
    }

    private fun showBoard() {
        wm = getSystemService(WINDOW_SERVICE) as WindowManager

        val panel = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(12, 12, 12, 12)
            background = GradientDrawable().apply {
                setColor(Color.WHITE)
                cornerRadius = 28f
                setStroke(2, Color.LTGRAY)
            }
        }

        val header = TextView(this).apply {
            text = "✍ السبورة العربية   ×"
            textSize = 18f
            setTextColor(Color.BLACK)
            setPadding(8, 12, 8, 12)
            setOnClickListener { stopSelf() }
        }
        panel.addView(header)

        val board = HandwritingBoard(this)
        panel.addView(
            board,
            LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT,
                300
            )
        )

        val output = EditText(this).apply {
            hint = "النص العربي الناتج"
            textSize = 18f
            gravity = Gravity.RIGHT or Gravity.TOP
            minLines = 2
        }
        panel.addView(
            output,
            LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT,
                120
            )
        )

        val copyButton = Button(this).apply {
            text = "نسخ النص إلى الملاحظات"
            setOnClickListener {
                val text = output.text.toString()
                if (text.isNotBlank()) {
                    val clipboard =
                        getSystemService(
                            Context.CLIPBOARD_SERVICE
                        ) as ClipboardManager

                    clipboard.setPrimaryClip(
                        ClipData.newPlainText("Arabic text", text)
                    )

                    Toast.makeText(
                        this@FloatingBoardService,
                        "تم نسخ النص. الصقه في تطبيق الملاحظات.",
                        Toast.LENGTH_LONG
                    ).show()
                }
            }
        }
        panel.addView(copyButton)

        val params = WindowManager.LayoutParams(
            340,
            WindowManager.LayoutParams.WRAP_CONTENT,
            WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,
            WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL,
            PixelFormat.TRANSLUCENT
        ).apply {
            gravity = Gravity.CENTER
        }

        floatingView = panel
        wm.addView(panel, params)
    }

    override fun onDestroy() {
        floatingView?.let {
            try {
                wm.removeView(it)
            } catch (_: Exception) {
            }
        }
        floatingView = null
        super.onDestroy()
    }
}

class HandwritingBoard(context: Context) : View(context) {
    private val paths = mutableListOf<Path>()
    private var currentPath: Path? = null

    private val pen = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        color = Color.rgb(35, 90, 210)
        strokeWidth = 7f
        style = Paint.Style.STROKE
        strokeCap = Paint.Cap.ROUND
        strokeJoin = Paint.Join.ROUND
    }

    init {
        setBackgroundColor(Color.WHITE)
    }

    override fun onDraw(canvas: Canvas) {
        super.onDraw(canvas)

        val guide = Paint().apply {
            color = Color.rgb(238, 242, 248)
            strokeWidth = 1f
        }

        var y = 45f
        while (y < height) {
            canvas.drawLine(0f, y, width.toFloat(), y, guide)
            y += 45f
        }

        paths.forEach { canvas.drawPath(it, pen) }
        currentPath?.let { canvas.drawPath(it, pen) }
    }

    override fun onTouchEvent(event: MotionEvent): Boolean {
        when (event.actionMasked) {
            MotionEvent.ACTION_DOWN -> {
                currentPath = Path().apply {
                    moveTo(event.x, event.y)
                }
                invalidate()
                return true
            }

            MotionEvent.ACTION_MOVE -> {
                currentPath?.lineTo(event.x, event.y)
                invalidate()
                return true
            }

            MotionEvent.ACTION_UP -> {
                currentPath?.let { paths.add(it) }
                currentPath = null
                invalidate()
                performClick()
                return true
            }
        }
        return true
    }

    override fun performClick(): Boolean {
        super.performClick()
        return true
    }
}
